<Window x:Class="DeskTemp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:DeskTemp.Controls"
        Title="DeskTemp"
        Width="294" Height="Auto" MinHeight="240" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Topmost="True"
        Opacity="0"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        Icon="Assets/app.ico">

    <Window.Resources>
        <SolidColorBrush x:Key="TextPrimary" Color="#EEF2F8" />
        <SolidColorBrush x:Key="TextMuted" Color="#7C8798" />
        <SolidColorBrush x:Key="TextFaint" Color="#5F6A7C" />

        <Style x:Key="GlyphButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Foreground" Value="#7C8798" />
            <Setter Property="Opacity" Value="0.75" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF" />
                                <Setter Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="#EEF2F8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#10FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#DDE5F0" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="6" Padding="9,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="9" Foreground="#7DD3FC" VerticalAlignment="Center"
                                           Visibility="Collapsed" />
                                <ContentPresenter Grid.Column="1" ContentSource="Header"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1FFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkContextMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="#F21A1F27" />
            <Setter Property="BorderBrush" Value="#2BFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel IsItemsHost="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border x:Name="RootCard" CornerRadius="20"
                Background="#FF171B23"
                BorderBrush="#28FFFFFF"
                BorderThickness="1"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TranslateTransform x:Name="CardOffset" Y="6" />
            </Border.RenderTransform>

            <Grid x:Name="ContentGrid" Margin="16,13,16,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="24" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="LiveDot" Width="5" Height="5" Fill="#34D399"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="实时温度" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" Margin="6,0,0,0"
                                   VerticalAlignment="Center" />
                        <Border Background="#1234D399" CornerRadius="4" Padding="4,1" Margin="8,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="LIVE" FontSize="6.5" FontWeight="Bold"
                                       Foreground="#6EE7B7" />
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button x:Name="MoreButton" Style="{StaticResource GlyphButton}"
                                Click="MoreButton_Click" ToolTip="选项">
                            <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                        </Button>
                        <Button x:Name="CloseButton" Style="{StaticResource GlyphButton}"
                                Click="CloseButton_Click" Margin="2,0,0,0" ToolTip="退出">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- CPU card -->
                <Border x:Name="CpuCard" Grid.Row="2" Background="#0CFFFFFF" BorderBrush="#0AFFFFFF"
                        BorderThickness="1" CornerRadius="14" Padding="12,10,12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="86" />
                        </Grid.ColumnDefinitions>

                        <StackPanel x:Name="CpuLeftPanel" Background="Transparent" HorizontalAlignment="Stretch">
                            <Grid HorizontalAlignment="Stretch" Margin="0,0,8,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="5" Height="5" Fill="#38BDF8" VerticalAlignment="Center"
                                             Margin="0,0,6,0" />
                                    <TextBlock Text="CPU" FontSize="10.5" FontWeight="SemiBold"
                                               Foreground="#DCE4EF" />
                                    <TextBlock x:Name="CpuNameText" Text="CPU" FontSize="8.5"
                                               Foreground="#6C7788" Margin="6,1,0,0"
                                               MaxWidth="88" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel x:Name="CpuMemPanel" Grid.Column="1" Orientation="Horizontal"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Margin="6,0,0,0" Background="Transparent" ToolTip="内存占用">
                                    <TextBlock Text="内存" FontSize="8"
                                               Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="CpuMemText" Text="--%" FontSize="8.5"
                                               Foreground="{StaticResource TextPrimary}"
                                               Margin="3,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <ctl:Sparkline x:Name="CpuSpark" Height="20" Margin="0,4,8,0"
                                           Min="20" Max="100" Stroke="#38BDF8">
                                <ctl:Sparkline.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#3A38BDF8" Offset="0" />
                                        <GradientStop Color="#0038BDF8" Offset="1" />
                                    </LinearGradientBrush>
                                </ctl:Sparkline.Fill>
                            </ctl:Sparkline>

                            <Grid x:Name="CpuBarTrack" Height="3" Margin="0,6,8,0">
                                <Border Background="#12FFFFFF" CornerRadius="1.5" />
                                <Border x:Name="CpuBarFill" Width="0" HorizontalAlignment="Left"
                                        Background="#38BDF8" CornerRadius="1.5" />
                            </Grid>

                            <Grid Margin="0,5,0,0">
                                <TextBlock x:Name="CpuLoadText" Text="负载 --" FontSize="8.5"
                                           Foreground="{StaticResource TextMuted}" />
                                <TextBlock x:Name="CpuDetailText" Text="-- GHz" FontSize="8.5"
                                           Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="CpuTempText" Text="--" FontFamily="Bahnschrift"
                                       FontSize="33" FontWeight="Light" Foreground="{StaticResource TextPrimary}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="°C" FontSize="9.5" Foreground="#697487" Margin="3,0,0,7"
                                       VerticalAlignment="Bottom" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- GPU card -->
                <Border x:Name="GpuCard" Grid.Row="4" Background="#0CFFFFFF" BorderBrush="#0AFFFFFF"
                        BorderThickness="1" CornerRadius="14" Padding="12,10,12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="86" />
                        </Grid.ColumnDefinitions>

                        <StackPanel x:Name="GpuLeftPanel" Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="5" Height="5" Fill="#A78BFA" VerticalAlignment="Center"
                                             Margin="0,0,6,0" />
                                    <TextBlock Text="GPU" FontSize="10.5" FontWeight="SemiBold"
                                               Foreground="#DCE4EF" />
                                    <TextBlock x:Name="GpuNameText" Text="GPU" FontSize="8.5"
                                               Foreground="#6C7788" Margin="6,1,0,0"
                                               MaxWidth="104" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock x:Name="GpuDetailText" Grid.Column="1" Text="-- W" FontSize="8"
                                           Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" />
                            </Grid>

                            <ctl:Sparkline x:Name="GpuSpark" Height="20" Margin="0,4,8,0"
                                           Min="20" Max="100" Stroke="#A78BFA">
                                <ctl:Sparkline.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#3AA78BFA" Offset="0" />
                                        <GradientStop Color="#00A78BFA" Offset="1" />
                                    </LinearGradientBrush>
                                </ctl:Sparkline.Fill>
                            </ctl:Sparkline>

                            <Grid x:Name="GpuBarTrack" Height="3" Margin="0,6,0,0">
                                <Border Background="#12FFFFFF" CornerRadius="1.5" />
                                <Border x:Name="GpuBarFill" Width="0" HorizontalAlignment="Left"
                                        Background="#A78BFA" CornerRadius="1.5" />
                            </Grid>

                            <Grid Margin="0,5,0,0">
                                <TextBlock x:Name="GpuLoadText" Text="负载 --" FontSize="8.5"
                                           Foreground="{StaticResource TextMuted}" />
                                <TextBlock x:Name="GpuMemText" Text="显存 --" FontSize="8"
                                           Foreground="{StaticResource TextMuted}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="GpuTempText" Text="--" FontFamily="Bahnschrift"
                                       FontSize="33" FontWeight="Light" Foreground="{StaticResource TextPrimary}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="°C" FontSize="9.5" Foreground="#697487" Margin="3,0,0,7"
                                       VerticalAlignment="Bottom" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Optional storage footer -->
                <Grid x:Name="StorageSection" Grid.Row="5" Margin="6,5,0,2" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="5" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Height="1" Background="#22FFFFFF" VerticalAlignment="Center" />
                    <WrapPanel x:Name="StoragePanel" Grid.Row="1" Width="260"
                               Margin="0,3,0,0" Orientation="Horizontal" />
                </Grid>

            </Grid>
        </Border>
    </Grid>

    <Window.ContextMenu>
        <ContextMenu Style="{StaticResource DarkContextMenu}">
            <ContextMenu.Resources>
                <Style TargetType="Separator">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Separator">
                                <Border Height="1" Background="#1AFFFFFF" Margin="6,4" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ContextMenu.Resources>
            <MenuItem x:Name="TopmostMenuItem" Header="始终置顶" IsCheckable="True"
                      StaysOpenOnClick="True" Style="{StaticResource DarkMenuItem}"
                      Click="TopmostMenuItem_Click" />
            <MenuItem x:Name="LockMenuItem" Header="锁定位置" IsCheckable="True"
                      StaysOpenOnClick="True" Style="{StaticResource DarkMenuItem}"
                      Click="LockMenuItem_Click" />
            <MenuItem x:Name="ShowStorageMenuItem" Header="显示硬盘温度" IsCheckable="True"
                      StaysOpenOnClick="True" Style="{StaticResource DarkMenuItem}"
                      Click="ShowStorageMenuItem_Click" />
            <Separator />
            <MenuItem Header="退出" Style="{StaticResource DarkMenuItem}" Click="ExitMenuItem_Click" />
        </ContextMenu>
    </Window.ContextMenu>
</Window>
